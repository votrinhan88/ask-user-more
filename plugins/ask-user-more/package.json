{
  "name": "ask-user-more",
  "version": "0.1.0",
  "description": "AskUserMore \u2014 richer multiple-choice questions for Claude Code",
  "type": "module",
  "bin": {
    "ask-user-more": "dist/server.mjs"
  },
  "files": [
    "dist",
    ".claude-plugin",
    ".mcp.json",
    "hooks",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.mjs && esbuild ../../packages/tui/src/host.ts --bundle --platform=node --format=esm --outfile=dist/tui.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.mjs",
    "test": "tsx --test test/*.test.ts test/*.test.mjs",
    "test:integration": "node test/mcp.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7",
    "@ask-user-more/core": "*",
    "tsx": "^4.19.2"
  }
}
