{
  "name": "ask-user-more",
  "version": "0.1.0",
  "description": "AskUserMore \u2014 richer multiple-choice questions for Claude Code",
  "type": "module",
  "bin": {
    "ask-user-more": "dist/server.mjs"
  },
  "files": [
    "dist",
    ".claude-plugin",
    ".mcp.json",
    "hooks",
    "skills",
    "pi",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.mjs && esbuild ../../packages/tui/src/host.ts --bundle --platform=node --format=esm --outfile=dist/tui.mjs && esbuild pi/index.ts --bundle --platform=node --format=esm --outfile=pi/index.js --external:@earendil-works/pi-coding-agent --external:@earendil-works/pi-tui --external:@earendil-works/pi-ai",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.mjs",
    "test": "tsx --test test/*.test.ts test/*.test.mjs",
    "test:integration": "node test/mcp.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7",
    "@ask-user-more/core": "*",
    "tsx": "^4.19.2",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-ai": "^1.3.0"
  },
  "keywords": [
    "pi-package",
    "claude-code-plugin",
    "ask-user",
    "mcp",
    "elicitation"
  ],
  "pi": {
    "extensions": [
      "./pi/index.js"
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/votrinhan88/ask-user-more.git"
  },
  "homepage": "https://github.com/votrinhan88/ask-user-more#readme",
  "bugs": {
    "url": "https://github.com/votrinhan88/ask-user-more/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
